# Project PULSE — Environment Configuration Template
# Copy this file to apps/web/.env.local for local development.

# Supabase Public API Endpoint (Found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous Key (Publishable safely in client applications)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Default Analytics Timezone (Asia/Dhaka)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Dhaka
